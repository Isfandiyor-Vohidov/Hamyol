PUBLIC_URL=https://safar.example.uz
PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT=safar_travellbot
ADMIN_TG_IDS=
ANTHROPIC_API_KEY=
BOOKING_AID=
# Туннель: ngrok (по умолчанию) или cloudflare. Cloudflare — без лимита трафика; без токена адрес *.trycloudflare.com новый при каждом запуске
TUNNEL=
NGROK_DOMAIN=
# Постоянный адрес через Cloudflare: токен туннеля (Zero Trust → Networks → Tunnels) и его домен
CF_TUNNEL_TOKEN=
CF_HOSTNAME=
OPERATOR=
CONTACT=
ADMIN_ENABLED=
ESIM_URL=
INSURANCE_URL=
# Точный онлайн-перевод на азербайджанский (бесплатная квота). Нужен один из ключей:
# Microsoft Translator F0 (2 млн символов/мес): ключ и регион ресурса из портала Azure
AZ_MS_KEY=
AZ_MS_REGION=
# или Google Cloud Translation (500 тыс. символов/мес)
AZ_GOOGLE_KEY=
