{
  "name": "Hamyol — путешествия по Узбекистану",
  "short_name": "Hamyol",
  "description": "Города, отели, базары, достопримечательности, карта, отзывы и бюджет поездки по Узбекистану.",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b1f3a",
  "theme_color": "#0b1f3a",
  "lang": "ru",
  "categories": [
    "travel",
    "navigation"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "./",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            "image/*",
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png"
          ]
        }
      ]
    }
  }
}
